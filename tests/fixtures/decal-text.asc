!PADS-POWERPCB-V9.5-MILS! DESIGN DATABASE ASCII FILE 1.0

*PCB*        GENERAL PARAMETERS OF THE PCB

UNITS 0
MAXIMUMLAYER 2

*PARTDECAL*  PART DECAL ITEMS

TEXT_DECAL I 0 0 0 0 0 2 0
-35 0 0 26 24 3 N LEFT DOWN 0
Regular <Romansim Stroke Font>
PIN 1
35 0 90 26 24 3 M RIGHT UP 0
Regular <Romansim Stroke Font>
POL +

*PARTTYPE*   PART TYPE ITEMS

TEXT_TYPE TEXT_DECAL I UND 0 0 0 0 Y

*PART*       PART ITEMS

U1 TEXT_TYPE 140 150 20 U N 0 -1 0 -1 0
U2 TEXT_TYPE 300 150 340 U M 0 -1 0 -1 0

*LINES*      LINES ITEMS

BOARD_OUTLINE BOARD 0 0 1 0
CLOSED 5 4 0 0
0 0
500 0
500 300
0 300
0 0

*MISC*      MISCELLANEOUS PARAMETERS

LAYER DATA
{
LAYER 1
{
LAYER_NAME Top
LAYER_TYPE ROUTING
}
LAYER 2
{
LAYER_NAME Bottom
LAYER_TYPE ROUTING
}
LAYER 26
{
LAYER_NAME Silkscreen Top
LAYER_TYPE SILK_SCREEN
}
LAYER 29
{
LAYER_NAME Silkscreen Bottom
LAYER_TYPE SILK_SCREEN
}
}

*END*
